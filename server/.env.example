# Smith AI Backend Environment Variables (Render)
# In production on Render, configure these in the Render Dashboard Environment tab.

PORT=10000
NODE_ENV=production

# Groq - LLM & Whisper Large v3 (Speech-to-Text)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_API_KEY=gsk_your_groq_whisper_api_key_here

# Google Gemini - Resume Intelligence & Code Submission Evaluation
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI - Codestral Coding Assessment & Fallback
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# CORS Origins (Allow your Vercel URL)
CLIENT_ORIGIN=https://smith-ai.vercel.app
CLIENT_ORIGINS=http://localhost:5173,https://smith-ai.vercel.app

# Authentication & Database
JWT_SECRET=smith_ai_production_jwt_secret_token_2026
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/smith_ai?retryWrites=true&w=majority
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
