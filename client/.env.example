# Smith AI Next.js Frontend Environment Variables (Vercel)
# In production on Vercel, set NEXT_PUBLIC_API_URL to your Render FastAPI backend URL.
# In local development, leave blank to use the Next.js local proxy (/api -> http://127.0.0.1:3001).

NEXT_PUBLIC_API_URL=https://smith-ai-backend.onrender.com
VITE_API_URL=https://smith-ai-backend.onrender.com
